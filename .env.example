# Copy this to .env.local (do NOT commit real secrets).
# SendGrid (preferred). Key must start with SG.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address (for SendGrid or SMTP 'from')
AUTH_EMAIL=your-verified@domain.com

# Recipient address for contact messages
CONTACT_EMAIL=you@domain.com

# Optional SMTP fallback (nodemailer). If provided, AUTH_EMAIL_PASSWORD is used.
AUTH_EMAIL_PASSWORD=your_smtp_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Optional: only for local debugging if you want to see submitted form data in the server console.
# Do not keep debug logs enabled in production.
